generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String            @id @default(cuid())
  name         String
  email        String            @unique
  passwordHash String
  role         String            @default("RESEARCHER") // OWNER, ADMIN, RESEARCHER, EDITOR, VIEWER
  avatarUrl    String?           @db.Text
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  assignedCases    Case[]            @relation("AssignedCases")
  createdCases     Case[]            @relation("CreatedCases")
  workspaceMembers WorkspaceMember[]
  tasks            Task[]            @relation("AssignedTasks")
  createdTasks     Task[]            @relation("CreatedTasks")
  verifiedItems    VerificationItem[]
  uploadedEvidence Evidence[]
  createdEvents    CaseEvent[]
  createdContents  Content[]
  notifications    Notification[]
  activityLogs     ActivityLog[]
  assignedIntakeItems IntakeItem[]     @relation("AssignedIntakeItems")
  reviewedIntakeItems IntakeItem[]     @relation("ReviewedIntakeItems")
}

model Workspace {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  description String?           @db.Text
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  members             WorkspaceMember[]
  cases               Case[]
  activityLogs        ActivityLog[]
  inboxMessages       InboxMessage[]
  intakeItems         IntakeItem[]
  submissionEndpoints SubmissionEndpoint[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        String    @default("RESEARCHER")
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model Case {
  id                 String    @id @default(cuid())
  caseNumber         String    @unique // e.g. CD-2026-00001
  workspaceId        String
  title              String
  summary            String    @db.Text
  category           String    // Healthcare, Government Services, Police / Law Enforcement, Education, etc.
  priority           String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status             String    @default("NEW") // NEW, TRIAGE, NEEDS_INFORMATION, UNDER_REVIEW, VERIFICATION, INVESTIGATION, CONTENT_READY, PUBLISHED, FOLLOW_UP, RESOLVED, CLOSED
  location           String
  sourceType         String    @default("TEXT") // TEXT, VOICE, MANUAL, WHATSAPP, EMAIL, SOCIAL
  sourceText         String?   @db.Text
  aiSummary          String?   @db.Text
  aiPriorityReason   String?   @db.Text
  verificationStatus String    @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, SUBSTANTIALLY_VERIFIED, DISPUTED
  publicationStatus  String    @default("NOT_PUBLISHED") // NOT_PUBLISHED, DRAFT_READY, APPROVED, PUBLISHED
  resolutionStatus   String    @default("OPEN") // OPEN, ONGOING, PARTIALLY_RESOLVED, RESOLVED, CLOSED
  nextAction         String?   @db.Text   // Concrete next operational step
  healthStatus       String    @default("ON_TRACK") // ON_TRACK, NEEDS_ATTENTION, BLOCKED
  healthReason       String?   @db.Text   // Diagnosis / reason for health status
  assignedToId       String?
  createdById        String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  publishedAt        DateTime?
  resolvedAt         DateTime?

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignedTo        User?              @relation("AssignedCases", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy         User               @relation("CreatedCases", fields: [createdById], references: [id], onDelete: Cascade)
  sources           Source[]
  claims            Claim[]
  verificationItems VerificationItem[]
  evidence          Evidence[]
  events            CaseEvent[]
  tasks             Task[]
  contacts          Contact[]
  responseRequests  ResponseRequest[]
  contents          Content[]
  activityLogs      ActivityLog[]
  inboxMessages     InboxMessage[]
  createdFromIntakes IntakeItem[]       @relation("CreatedCaseFromIntake")
  mergedIntakes      IntakeItem[]       @relation("MergedIntakeItems")

  @@index([workspaceId])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([healthStatus])
}

model Source {
  id                String    @id @default(cuid())
  caseId            String
  name              String
  phone             String?
  email             String?
  preferredLanguage String    @default("English")
  location          String?
  anonymous         Boolean   @default(false)
  consentToContact  Boolean   @default(true)
  consentToPublish  Boolean   @default(false)
  notes             String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model Claim {
  id        String   @id @default(cuid())
  caseId    String
  text      String   @db.Text
  status    String   @default("UNVERIFIED") // UNVERIFIED, PARTIALLY_SUPPORTED, SUPPORTED, DISPUTED
  source    String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model VerificationItem {
  id               String    @id @default(cuid())
  caseId           String
  statement        String    @db.Text
  status           String    @default("PENDING") // PENDING, VERIFIED, NOT_VERIFIED, DISPUTED
  evidenceRequired String?   @db.Text
  notes            String?   @db.Text
  verifiedById     String?
  verifiedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  case       Case  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  verifiedBy User? @relation(fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([caseId])
}

model Evidence {
  id                 String   @id @default(cuid())
  caseId             String
  name               String
  type               String   @default("DOCUMENT") // DOCUMENT, IMAGE, VIDEO, AUDIO, MESSAGE, OTHER
  filePath           String   @db.Text
  mimeType           String
  size               Int
  description        String?  @db.Text
  verificationStatus String   @default("UNVERIFIED")
  uploadedById       String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  case       Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model CaseEvent {
  id          String   @id @default(cuid())
  caseId      String
  type        String   // CASE_CREATED, INFORMATION_REQUESTED, DOCUMENT_UPLOADED, CLAIM_ADDED, VERIFICATION_UPDATED, CONTACT_CREATED, RESPONSE_REQUESTED, RESPONSE_RECEIVED, CONTENT_CREATED, CONTENT_PUBLISHED, FOLLOW_UP_CREATED, STATUS_CHANGED
  title       String
  description String?  @db.Text
  createdById String?
  eventDate   DateTime @default(now())
  createdAt   DateTime @default(now())

  case      Case  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([caseId])
}

model Task {
  id           String    @id @default(cuid())
  caseId       String
  title        String
  description  String?   @db.Text
  status       String    @default("TODO") // TODO, IN_PROGRESS, DONE
  priority     String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  assignedToId String?
  dueDate      DateTime?
  createdById  String
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  case       Case  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  assignedTo User? @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy  User  @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([assignedToId])
}

model Contact {
  id           String   @id @default(cuid())
  caseId       String
  name         String
  organization String?
  role         String?
  phone        String?
  email        String?
  type         String   @default("AUTHORITY") // AUTHORITY, ORGANIZATION, EXPERT, WITNESS, SOURCE, OTHER
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  case             Case              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  responseRequests ResponseRequest[]

  @@index([caseId])
}

model ResponseRequest {
  id                 String    @id @default(cuid())
  caseId             String
  contactId          String
  requestedAt        DateTime  @default(now())
  deadline           DateTime?
  method             String    @default("Email")
  status             String    @default("NOT_REQUESTED") // NOT_REQUESTED, REQUESTED, FOLLOW_UP_REQUIRED, RECEIVED, NO_RESPONSE
  responseText       String?   @db.Text
  responseReceivedAt DateTime?
  notes              String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  case    Case    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([contactId])
}

model Content {
  id          String    @id @default(cuid())
  caseId      String
  type        String    // INSTAGRAM_REEL, YOUTUBE_VIDEO, YOUTUBE_SHORT, INSTAGRAM_CAROUSEL, ARTICLE, SOCIAL_POST
  title       String
  body        String    @db.MediumText
  status      String    @default("DRAFT") // DRAFT, IN_REVIEW, APPROVED, PUBLISHED, ARCHIVED
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  case      Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ActivityLog {
  id          String   @id @default(cuid())
  workspaceId String
  caseId      String?
  userId      String
  action      String
  metadata    String?  @db.Text
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  case      Case?     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([caseId])
}

model InboxMessage {
  id                  String   @id @default(cuid())
  workspaceId         String
  sourceChannel       String   // WHATSAPP, INSTAGRAM_DM, EMAIL, WEB_PORTAL, VOICE_NOTE
  senderName          String
  senderContact       String?
  rawText             String   @db.MediumText
  receivedAt          DateTime @default(now())
  status              String   @default("UNPROCESSED") // UNPROCESSED, PROCESSED, IGNORED
  convertedCaseId     String?
  aiSuggestedCategory String?
  aiSuggestedPriority String?  // LOW, MEDIUM, HIGH, URGENT
  aiSuggestedTitle    String?
  aiSummary           String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  convertedCase Case?     @relation(fields: [convertedCaseId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([status])
}

model IntakeItem {
  id                    String             @id @default(cuid())
  workspaceId           String
  sourceType            String             // WHATSAPP, INSTAGRAM, EMAIL, VOICE, WEB_FORM, MANUAL, OTHER
  senderName            String
  senderPhone           String?
  senderEmail           String?
  preferredLanguage     String             @default("English") // Telugu, English, Other
  rawText               String             @db.MediumText
  transcription         String?            @db.MediumText // Voice transcription
  attachmentCount       Int                @default(0)
  status                String             @default("NEEDS_REVIEW") // INCOMING, AI_TRIAGED, NEEDS_REVIEW, NEEDS_INFORMATION, CASE_CREATED, MERGED, ARCHIVED
  archiveReason         String?            // SPAM, OUT_OF_SCOPE, DUPLICATE, INSUFFICIENT_INFORMATION, NOT_RELEVANT, OTHER
  aiCategory            String?
  aiSummary             String?            @db.Text
  aiPriority            String?            // LOW, MEDIUM, HIGH, URGENT
  aiPriorityReason      String?            @db.Text
  aiLocation            String?
  aiEntities            String?            @db.MediumText // JSON string: { people: string[], organizations: string[], dates: string[] }
  aiClaims              String?            @db.MediumText // JSON string: string[]
  aiMissingInformation String?            @db.MediumText // JSON string: string[]
  sensitiveInfoDetected String?            @db.MediumText // JSON string: string[]
  duplicateCandidate    Boolean            @default(false)
  duplicateCaseId       String?            // Case candidate ID
  assignedToId          String?
  createdCaseId         String?            // Case created from this intake item
  referenceNumber       String?            // e.g. CD-IN-2026-00182
  consentToContact      Boolean            @default(true)
  consentToPublish      String             @default("DISCUSS_FIRST") // YES, NO, DISCUSS_FIRST
  endpointSlug          String?
  incidentDate          String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  reviewedAt            DateTime?
  reviewedById          String?

  workspace             Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdCase           Case?              @relation("CreatedCaseFromIntake", fields: [createdCaseId], references: [id], onDelete: SetNull)
  mergedCase            Case?              @relation("MergedIntakeItems", fields: [duplicateCaseId], references: [id], onDelete: SetNull)
  assignedTo            User?              @relation("AssignedIntakeItems", fields: [assignedToId], references: [id], onDelete: SetNull)
  reviewedBy            User?              @relation("ReviewedIntakeItems", fields: [reviewedById], references: [id], onDelete: SetNull)
  attachments           IntakeAttachment[]

  @@index([workspaceId])
  @@index([status])
  @@index([sourceType])
  @@index([aiPriority])
  @@index([createdCaseId])
  @@index([duplicateCaseId])
  @@index([referenceNumber])
}

model IntakeAttachment {
  id           String     @id @default(cuid())
  intakeItemId String
  fileName     String
  filePath     String     @db.Text
  mimeType     String
  size         Int
  type         String     @default("DOCUMENT") // IMAGE, VIDEO, AUDIO, DOCUMENT, OTHER
  createdAt    DateTime   @default(now())

  intakeItem   IntakeItem @relation(fields: [intakeItemId], references: [id], onDelete: Cascade)

  @@index([intakeItemId])
}

model SubmissionEndpoint {
  id               String    @id @default(cuid())
  workspaceId      String
  slug             String    @unique
  title            String
  description      String?   @db.Text
  isActive         Boolean   @default(true)
  requireContact   Boolean   @default(false)
  allowAnonymous   Boolean   @default(true)
  allowVoice       Boolean   @default(true)
  allowAttachments Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([slug])
}
