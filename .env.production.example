# ================================================================
# CaseDesk & Citizen Portal Production Environment Configuration
# ================================================================

# --- External MySQL Database Connection ---
# Format: mysql://<user>:<password>@<host>:<port>/<database_name>
# Example: mysql://casedesk_user:MySecurePass123!@192.168.1.50:3306/casedesk_db
DATABASE_URL=mysql://root:password@mysql-host:3306/casedesk

# --- Core Security ---
NODE_ENV=production
SESSION_SECRET=replace-with-a-very-long-and-random-32-char-secret-string

# --- Newsroom Branding ---
NEXT_PUBLIC_APP_NAME=CaseDesk
NEXT_PUBLIC_DEFAULT_SLUG=janata-investigation-desk

# --- URLs for Public Citizen Traffic & Creator Newsroom ---
# External URL where citizens & journalists access CaseDesk:
NEXT_PUBLIC_CASEDESK_API_URL=http://localhost:3000
# External URL where creators can link out to the citizen portal:
NEXT_PUBLIC_CITIZEN_PORTAL_URL=http://localhost:3001

# --- AI Integration (Groq API Key) ---
# Used for Whisper Large V3 voice transcription & Llama 3.3 70B triage
GROQ_API_KEY=your_groq_api_key_here
