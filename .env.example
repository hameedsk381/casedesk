# === CaseDesk / Open Vaartha — Environment Configuration ===
# Copy to .env and fill in. Production deployments must provide every required
# secret and must never use the example values below.

# --- AI (voice transcription + triage) ---
# Get a key at https://console.groq.com
GROQ_API_KEY=

# --- SMTP email delivery ---
# Required for newsroom notifications and welcome emails.
# Gmail example: HOST=smtp.gmail.com PORT=465 SECURE=true USER=you@gmail.com PASS=<app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Open Vaartha CaseDesk <no-reply@openvaartha.com>

# Who receives new citizen report notifications.
# Leave empty to notify all workspace members (first 10) instead.
WORKSPACE_NOTIFY_EMAIL=

# Public URL of the CaseDesk app (used in email links)
APP_URL=http://localhost:3000

# --- External MySQL database ---
DATABASE_URL=mysql://user:password@db.example.com:3306/casedesk
DOCKER_DATABASE_URL=mysql://user:password@db.example.com:3306/casedesk

# --- Sessions ---
# CHANGE THIS in production — sign sessions with a long random string
SESSION_SECRET=change-me-to-a-long-random-string

# --- Citizen Portal ---
NEXT_PUBLIC_CASEDESK_API_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_SLUG=janata-investigation-desk
NEXT_PUBLIC_CITIZEN_PORTAL_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=Open Vaartha CaseDesk

# --- Security and deployment ---
TRUSTED_PROXY=false
CORS_ALLOWED_ORIGINS=http://localhost:3001
DB_MIGRATION_MODE=deploy
ALLOW_DB_PUSH=false

# Optional: enables POST /api/cron/escalate (Bearer token) for external schedulers.
# The app also escalates unanswered authority responses hourly by itself.
CRON_SECRET=

# Staff signup is CLOSED unless SIGNUP_ENABLED=true. Restrict it with a comma-separated
# list of emails or @domains. Empty list + enabled = anyone can register.
SIGNUP_ENABLED=false
ALLOWED_SIGNUP_EMAILS=

# --- First-time admin bootstrap ---
# docker compose up creates the admin account, workspace and public submission
# endpoint at startup when both are set (outside Docker: npm run create-admin).
# Remove ADMIN_PASSWORD from this file once the account exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: ADMIN_NAME, WORKSPACE_NAME, WORKSPACE_SLUG, ENDPOINT_SLUG, ENDPOINT_TITLE, ADMIN_RESET_PASSWORD

# Public https address of the citizen portal (printable ward QR codes use it).
PUBLIC_PORTAL_URL=
